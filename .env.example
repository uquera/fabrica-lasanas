# Copiar a .env y completar. NUNCA subir .env al repositorio.
# Postgres local del VPS (base "donnaany"); producción migró desde Supabase el 2026-10-21.
DATABASE_URL="postgresql://donnaany:clave@127.0.0.1:5432/donnaany"
DIRECT_URL="postgresql://donnaany:clave@127.0.0.1:5432/donnaany"
AUTH_SECRET=                 # openssl rand -base64 32
# Correos: estándar no-reply de Hypnos (nunca desde el Gmail del cliente)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="contacto@hypnosapps.com"
EMAIL_PASS=                  # app password "Agendas Hypnos" de contacto@ (la carga el usuario)
EMAIL_FROM="Doña Any <no-reply@hypnosapps.com>"
EMAIL_REPLY_TO="donna.any.cl@gmail.com"
ADMIN_EMAIL="donna.any.cl@gmail.com"
GEMINI_API_KEY=              # opcional: OCR de guías
NODE_ENV=production
