generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id               String             @id @default(cuid())
  rut              String
  razonSocial      String
  sucursal         String?
  direccion        String
  giro             String
  email            String
  emailCopia       String?            // 2º destinatario de las guías de despacho
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  envios           Envio[]
  mermas           Merma[]
  solicitudes      SolicitudPedido[]
}

model SolicitudPedido {
  id           String   @id @default(cuid())
  clienteId    String
  tienda       String
  cantidad     Int
  nota         String?
  responsable  String?
  fechaEntrega DateTime
  estado       String   @default("pendiente")  // pendiente | confirmada | despachada
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cliente      Cliente  @relation(fields: [clienteId], references: [id])
}

model Producto {
  id         String         @id @default(cuid())
  sku        String         @unique
  nombre     String
  precioBase Float          @default(5042)
  tasaIva    Float          @default(0.19)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  detalles   DetalleEnvio[]
  mermas     Merma[]
}

model Envio {
  id               String         @id @default(cuid())
  folio            Int?           @unique
  fecha            DateTime       @default(now())
  clienteId        String
  guiaDespacho     String?
  // Envío de la guía por email, procesado en el servidor (src/lib/colaGuias.ts):
  // "pendiente" | "enviando" | "sent" | "no_email" | "error"
  emailEstado      String?
  emailError       String?
  emailEnviadoAt   DateTime?
  facturado        Boolean        @default(false)
  facturaId        String?
  pagado           Boolean        @default(false)
  fechaPago        DateTime?
  comprobantePago  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  detalles         DetalleEnvio[]
  cliente          Cliente        @relation(fields: [clienteId], references: [id])
  mermas           Merma[]
}

model DetalleEnvio {
  id             String   @id @default(cuid())
  envioId        String
  productoId     String
  cantidad       Int
  precioUnitario Float?   // precio neto congelado al momento del despacho; si es null se usa producto.precioBase
  envio          Envio    @relation(fields: [envioId], references: [id])
  producto       Producto @relation(fields: [productoId], references: [id])
}

model Merma {
  id          String   @id @default(cuid())
  fecha       DateTime @default(now())
  clienteId   String
  productoId  String
  envioId     String?
  cantidad    Int
  motivo      String?
  responsable String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  envio      Envio?   @relation(fields: [envioId], references: [id])
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  producto   Producto @relation(fields: [productoId], references: [id])
}

model Usuario {
  id           String               @id @default(cuid())
  username     String               @unique
  email        String
  passwordHash String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  resetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  username  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  usuario   Usuario   @relation(fields: [username], references: [username])
}

// ─── CAMPAÑA SÁNDWICH (estreno nocturno Iquique) ─────────────────────────────

model SanwichLead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  code      String   @unique
  reward    String   @default("2x1 en churrascos")
  redeemed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── TIME MARKET: guías de despacho/retiro por tienda ────────────────────────
// Misma lógica que la planilla "Guia Tiendas TM":
//   venta efectiva de una guía = entrega de esa guía − devolución registrada en la guía siguiente

model TmConfig {
  id               Int      @id @default(1)
  precioIndividual Float    @default(5300)   // neto
  tasaIva          Float    @default(0.19)
  updatedAt        DateTime @updatedAt
}

model TmTienda {
  id        String    @id @default(cuid())
  nombre    String    @unique
  direccion String    @default("")
  orden     Int       @default(0)
  activa    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lineas    TmLinea[]
}

model TmGuia {
  id               String    @id @default(cuid())
  fecha            DateTime  @unique          // fecha de la visita del camión (despacho)
  precioIndividual Float                      // neto, congelado al crear la guía
  tasaIva          Float     @default(0.19)
  nota             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lineas           TmLinea[]

  @@index([fecha])
}

model TmLinea {
  id                   String   @id @default(cuid())
  guiaId               String
  tiendaId             String
  entregaIndividual    Int      @default(0)
  devolucionIndividual Int      @default(0)   // retirado en esta visita (corresponde a la guía anterior)
  guia                 TmGuia   @relation(fields: [guiaId], references: [id], onDelete: Cascade)
  tienda               TmTienda @relation(fields: [tiendaId], references: [id])

  @@unique([guiaId, tiendaId])
}
